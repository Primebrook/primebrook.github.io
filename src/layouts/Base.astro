---
import 'katex/dist/katex.min.css';
import '../styles/global.css';
import { SITE } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Ask search engines not to index this page. */
  noindex?: boolean;
}

const { title, description = SITE.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const year = new Date().getFullYear();
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <header class="site-header">
      <nav>
        <a href="/">Home</a>
        <a href="/about/">About</a>
      </nav>
      <a class="wordmark" href="/">{SITE.author}</a>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <span>{SITE.author} © {year}</span>
      <span class="links">
        {SITE.links.map((link) => <a href={link.href}>{link.label}</a>)}
      </span>
    </footer>
  </body>
</html>
