---
import Base from '../layouts/Base.astro';
import { SITE } from '../site';
import { getListedPosts, minutesRead } from '../lib/posts';

const posts = await getListedPosts();
// "15 Sep": en-GB abbreviates September to "Sept", so build it from parts.
const day = new Intl.DateTimeFormat('en-GB', { day: '2-digit' });
const month = new Intl.DateTimeFormat('en-US', { month: 'short' });
const fmt = (date: Date) => `${day.format(date)} ${month.format(date)}`;
---

<Base>
  <div class="home">
  <p class="intro">{SITE.description}</p>

  {
    posts.length === 0 ? (
      <p class="empty">Nothing published yet.</p>
    ) : (
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <time datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
            <a href={`/writing/${post.id}/`}>{post.data.title}</a>
            <span class="read">{minutesRead(post)} min read</span>
          </li>
        ))}
      </ul>
    )
  }
  </div>
</Base>
