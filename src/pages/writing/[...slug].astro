---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getPosts, minutesRead, type Post } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const date = new Intl.DateTimeFormat('en-GB', { dateStyle: 'long' }).format(post.data.pubDate);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{date}</time> · {minutesRead(post)} min read
      </p>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
