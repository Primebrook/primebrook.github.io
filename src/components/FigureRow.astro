---
// Two or more figures side by side under one caption, e.g. a good and a bad
// example. Stacks them on a phone. Put the figures in the slot without their
// own label or caption.
interface Props {
  /** Shown in bold before the caption, e.g. "Fig 2." */
  label?: string;
  caption?: string;
}

const { label, caption } = Astro.props;
---

<figure class="figure-row">
  <div class="items">
    <slot />
  </div>
  {
    (label || caption) && (
      <figcaption>
        {label && <strong>{label}</strong>} {caption}
      </figcaption>
    )
  }
</figure>

<style>
  .figure-row {
    margin: 2rem 0;
  }
  .items {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1rem;
  }
  .figure-row .items > :global(*) {
    margin: 0;
    min-width: 0;
  }
  figcaption {
    margin-top: 0.6rem;
    text-align: center;
    color: var(--muted);
    font-size: 0.85rem;
  }
  figcaption strong {
    color: var(--text);
  }
</style>
