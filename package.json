{
  "name": "primebrook-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "verify": "astro build && node scripts/verify-dist.mjs",
    "inspect": "node scripts/inspect.mjs",
    "verify:drafts": "INCLUDE_DRAFTS=1 astro build && node scripts/verify-dist.mjs && echo 'dist/ now contains drafts: run npm run build before anything that uses dist/ as the real site'"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/mdx": "^8.0.2",
    "astro": "^7.3.5",
    "katex": "^0.18.9",
    "mermaid": "^12.0.0",
    "pseudocode": "^2.4.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "unist-util-visit": "^5.1.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.6.2",
    "typescript": "^6.0.3"
  }
}
